# PUBLIC_HOST is the Web host name, e.g. openmeshtak.example.org. Caddy obtains and renews its
# Let's Encrypt certificate. Core's TAK ports are published by the Core container directly.
{$PUBLIC_HOST} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy {$CORE_ADDRESS:core:3000}
	}

	handle {
		root * /srv
		# Hashed build assets never change; the shell itself must always be revalidated.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
	}
}
